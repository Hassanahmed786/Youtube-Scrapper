# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file (it is listed in .gitignore).

# YouTube Data API v3 key.
# Create it in Google Cloud Console > APIs & Services > Credentials > Create credentials > API key.
# If this is empty the app still works, but only through yt-dlp (slower).
YOUTUBE_API_KEY=

# ID of your Google Sheet. It is the long part of the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
# The sheet must be shared with the service account email as Editor.
GOOGLE_SHEET_ID=

# Path to the service account JSON key you downloaded from Google Cloud.
# A relative path starts in the project folder, so "service_account.json" works
# if you put the file next to app.py.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Any long random text, Flask uses it to sign the session cookie.
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
